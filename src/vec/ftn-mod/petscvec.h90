interface
  subroutine PetscSFBcastBegin(sf, unit, rarray, larray, op, ierr)
    use, intrinsic :: ISO_C_binding
#if defined(PETSC_USE_MPI_F08)
    import tPetscSF, MPI_Datatype, MPI_Op
#else
    import tPetscSF
#endif
    PetscSF :: sf
    MPIU_Datatype :: unit
    MPIU_Op :: op
    type(*) :: rarray(:)
    type(*) :: larray(:)
    PetscErrorCode :: ierr
  end subroutine PetscSFBcastBegin

  subroutine PetscSFBcastEnd(sf, unit, rarray, larray, op, ierr)
    use, intrinsic :: ISO_C_binding
#if defined(PETSC_USE_MPI_F08)
    import tPetscSF, MPI_Datatype, MPI_Op
#else
    import tPetscSF
#endif
    PetscSF :: sf
    MPIU_Datatype :: unit
    MPIU_Op :: op
    type(*) :: rarray(:)
    type(*) :: larray(:)
    PetscErrorCode :: ierr
  end subroutine PetscSFBcastEnd

  subroutine PetscSFReduceBegin(sf, unit, larray, rarray, op, ierr)
    use, intrinsic :: ISO_C_binding
#if defined(PETSC_USE_MPI_F08)
    import tPetscSF, MPI_Datatype, MPI_Op
#else
    import tPetscSF
#endif
    PetscSF :: sf
    MPIU_Datatype :: unit
    MPIU_Op :: op
    type(*) :: larray(:)
    type(*) :: rarray(:)
    PetscErrorCode :: ierr
  end subroutine PetscSFReduceBegin

  subroutine PetscSFReduceEnd(sf, unit, larray, rarray, op, ierr)
    use, intrinsic :: ISO_C_binding
#if defined(PETSC_USE_MPI_F08)
    import tPetscSF, MPI_Datatype, MPI_Op
#else
    import tPetscSF
#endif
    PetscSF :: sf
    MPIU_Datatype :: unit
    MPIU_Op :: op
    type(*) :: larray(:)
    type(*) :: rarray(:)
    PetscErrorCode :: ierr
  end subroutine PetscSFReduceEnd

  subroutine VecRestoreOwnershipRanges(x, ranges, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: x
    PetscInt, pointer :: ranges(:)
    PetscErrorCode, intent(out) :: ierr
  end subroutine VecRestoreOwnershipRanges

  subroutine PetscSFRestoreGraph(sf, nroots, nleaves, ilocal, iremote, ierr)
    use, intrinsic :: ISO_C_binding
    import tPetscSF, sPetscSFNode
    PetscSF :: sf
    PetscInt :: nroots, nleaves
    PetscInt, pointer :: ilocal(:)
    type(sPetscSFNode), pointer :: iremote(:)
    PetscErrorCode :: ierr
  end subroutine PetscSFRestoreGraph

  subroutine VecRestoreValuesSection(v, s, point, values, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec, tPetscSection
    PetscScalar, pointer :: values(:)
    PetscErrorCode, intent(out) :: ierr
    Vec v
    PetscSection s
    PetscInt point
  end subroutine VecRestoreValuesSection

  subroutine VecCUDAGetArray(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDAGetArray

  subroutine VecCUDARestoreArray(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDARestoreArray

  subroutine VecCUDAGetArrayRead(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDAGetArrayRead

  subroutine VecCUDARestoreArrayRead(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDARestoreArrayRead

  subroutine VecCUDAGetArrayWrite(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDAGetArrayWrite

  subroutine VecCUDARestoreArrayWrite(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecCUDARestoreArrayWrite

  subroutine VecHIPGetArray(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPGetArray

  subroutine VecHIPRestoreArray(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPRestoreArray

  subroutine VecHIPGetArrayRead(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPGetArrayRead

  subroutine VecHIPRestoreArrayRead(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPRestoreArrayRead

  subroutine VecHIPGetArrayWrite(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPGetArrayWrite

  subroutine VecHIPRestoreArrayWrite(v, a, ierr)
    use, intrinsic :: ISO_C_binding
    import tVec
    Vec :: v
    PetscScalar, pointer :: a(:)
    PetscErrorCode :: ierr
  end subroutine VecHIPRestoreArrayWrite
end interface

