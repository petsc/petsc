interface
  subroutine PetscQuadratureRestoreData(q, dim, Nc, npoints, points, weights, ierr)
    use, intrinsic :: ISO_C_binding
    import tPetscQuadrature
    PetscInt dim, Nc, npoints
    PetscReal, pointer :: points(:)
    PetscReal, pointer :: weights(:)
    PetscErrorCode, intent(out) :: ierr
    PetscQuadrature q
  end subroutine
end interface

#if defined(PETSC_DLL_EXPORTS)
!DEC$ ATTRIBUTES DLLEXPORT::PetscQuadratureRestoreData
#endif
