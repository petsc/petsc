#!/usr/bin/python3 -S
#  Wrapper for Intel oneAPI icx compiler on Microsoft Windows using the
#  Python win32fe in-process (equivalent to: win32fe icl --use icx "$@")
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "python"))
from win32fe_frontends import main

sys.exit(main([sys.argv[0], "icl", "--use", "icx"] + sys.argv[1:]))
